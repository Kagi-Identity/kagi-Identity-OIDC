# Public origin of this OP. Must be the exact origin users see (no trailing slash).
# For passkeys the RP ID must be a registrable domain that matches this host.
KAGI_ISSUER=http://localhost:8080
KAGI_BIND=127.0.0.1:8080

# WebAuthn relying party
KAGI_RP_ID=localhost
KAGI_RP_NAME=kagi

# Storage: SQLite by default (local development).
KAGI_DB=kagi.db

# Storage: PostgreSQL / Supabase. When set, this wins over KAGI_DB.
# Use the Supabase "Connection string" (session pooler / direct, TLS required):
# KAGI_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# Table definitions live in supabase/schema.sql; they are applied at start-up.

# Bootstrap a demo relying party (public client, PKCE) on first start.
# The included demo page lives at /demo.
KAGI_SEED_DEMO=1

# Allow open sign-up with passkeys
KAGI_ALLOW_SIGNUP=1

# FAPI 2.0 style strictness: force PAR and DPoP for every client
KAGI_REQUIRE_PAR=0
KAGI_REQUIRE_DPOP=0

# Bearer token for /admin/keys/rotate. Unset disables the endpoint.
# KAGI_ADMIN_TOKEN=change-me

# Optional initial access token for RFC 7591 dynamic client registration.
# KAGI_REGISTRATION_TOKEN=
