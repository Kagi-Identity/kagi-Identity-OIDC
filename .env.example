# Local development defaults only. Review docs/DEPLOYMENT.md before deploying anywhere public.
# Public issuer origin; no trailing slash.
KAGI_ISSUER=http://localhost:8080
KAGI_BIND=127.0.0.1:8080

# WebAuthn. RP ID is a bare host/domain; origin includes scheme and optional port.
KAGI_RP_ID=localhost
KAGI_RP_NAME="Kagi Identity"
KAGI_ORIGIN=http://localhost:8080

# SQLite by default. Keep this file/database private and back it up securely.
KAGI_DB=kagi.db

# Optional PostgreSQL / Supabase. If set, this takes precedence over KAGI_DB.
# Prefer the Supavisor transaction/session pooler URL for serverless workloads.
# The application enforces TLS for PostgreSQL connections.
# KAGI_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Local-only demo relying party.
KAGI_SEED_DEMO=1
KAGI_ALLOW_SIGNUP=1

# OAuth profile strictness. These are not a certification claim.
KAGI_REQUIRE_PAR=0
KAGI_REQUIRE_DPOP=0

# Set strong random values in a secret manager when enabling these features.
# Never use these placeholders in a deployed environment.
# KAGI_ADMIN_TOKEN=
# KAGI_REGISTRATION_TOKEN=

# Browser origins allowed to call API endpoints. Use exact HTTPS origins in production.
# KAGI_CORS_ORIGINS=https://your-rp.example.com,https://another-rp.example.com

# Cookie / proxy controls. Defaults derive Secure/HSTS from the HTTPS issuer.
# Only trust forwarded client IPs behind a proxy that overwrites X-Forwarded-For.
# KAGI_COOKIE_SECURE=1
# KAGI_HSTS=1
# KAGI_TRUST_PROXY=0
# KAGI_RATE_LIMIT=1 (shared PostgreSQL-backed counters)

# Session / token lifetime values (seconds).
# KAGI_SESSION_TTL=28800
# KAGI_SESSION_IDLE_TTL=7200
# KAGI_CODE_TTL=60
# KAGI_ACCESS_TTL=300
# KAGI_REFRESH_TTL=2592000
# KAGI_ID_TTL=300
# KAGI_PAR_TTL=90

# Additional account controls.
# KAGI_RECOVERY_ENABLED=1
# KAGI_MAX_PASSKEYS=10
# KAGI_AUDIT_RETENTION_DAYS=90
