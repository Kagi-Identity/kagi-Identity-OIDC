# Copy to .env.production and replace every example value.
# Never commit .env.production or reuse these examples as real credentials.

# Public DNS name. Point this name at the Docker host before starting Caddy.
KAGI_DOMAIN=identity.example.com
ACME_EMAIL=ops@example.com

# These must match the public HTTPS endpoint and WebAuthn RP configuration.
KAGI_ISSUER=https://identity.example.com
KAGI_ORIGIN=https://identity.example.com
KAGI_RP_ID=identity.example.com
KAGI_RP_NAME=Example Identity

# Use a managed PostgreSQL service with TLS enabled. The application enforces
# TLS and this URL must be reachable from the Docker host.
KAGI_DATABASE_URL=postgresql://kagi:REPLACE_WITH_PASSWORD@db.example.com:5432/kagi?sslmode=require
KAGI_AUTO_MIGRATE=0

# Production guardrails. The Caddy container is the only public entry point.
KAGI_ENV=production
KAGI_BIND=0.0.0.0:8080
KAGI_COOKIE_SECURE=1
KAGI_HSTS=1
KAGI_SEED_DEMO=0
KAGI_ALLOW_SIGNUP=0
KAGI_REQUIRE_PAR=1
KAGI_REQUIRE_DPOP=1
KAGI_TRUST_PROXY=1
KAGI_RATE_LIMIT=1

# Add the exact HTTPS origins of browser-based relying parties.
# Server-to-server OIDC clients may not need cross-origin access.
KAGI_CORS_ORIGINS=https://app.example.com

# Generate two different high-entropy values, e.g.:
# openssl rand -base64 48
KAGI_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
KAGI_REGISTRATION_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
